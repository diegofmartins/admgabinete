# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Backend — SEGREDOS: configurar no PaaS; nunca incluir no bundle do front.
# ---------------------------------------------------------------------------
# Conteúdo JSON completo da conta de serviço do Firebase (uma linha só).
# Alternativa: deixar em branco e usar ADC com FIREBASE_PROJECT_ID.
FIREBASE_SERVICE_ACCOUNT=""
FIREBASE_PROJECT_ID="admgabinete-46aaa"

# Namespace das coleções no Firestore: <prefixo>_<colecao>.
# Ausente/vazio = "prod" (fail-safe). Use "test" na instância de homologação.
FIRESTORE_PREFIX="prod"

PORT="3001"

# E-mail institucional a promover a admin (usuário já deve ter entrado uma vez).
SEED_ADMIN_EMAIL=""

# ---------------------------------------------------------------------------
# Front — PÚBLICO: VITE_* entra no bundle (a apiKey Web SDK não é segredo).
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyCNAwBguNmcNRsEHtgmPywRkW5dqYD32XE"
VITE_FIREBASE_AUTH_DOMAIN="admgabinete-46aaa.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="admgabinete-46aaa"
VITE_FIREBASE_APP_ID="1:332315734910:web:e08201de1d6c66d8aa792f"

# Mesma origem por padrão; use URL absoluta somente com espelho no Pages + CORS.
VITE_API_URL="/api"
